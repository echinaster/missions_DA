<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Douaisis Agglo • Benchmark Solutions & IA</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; }
    body { background: #fdf2f7; color: #1e293b; padding: 24px 16px; display: flex; justify-content: center; }

    .form-card { background: #ffffff; width: 100%; max-width: 650px; border-radius: 16px; border: 1px solid #fad0e4; box-shadow: 0 10px 25px -5px rgba(142, 28, 86, 0.08); overflow: hidden; }
    .form-header { background: #8e1c56; color: #ffffff; padding: 24px; text-align: left; }
    .form-header h1 { font-size: 18px; font-weight: 800; letter-spacing: 0.5px; }
    .form-header p { font-size: 12px; color: #fce7f1; margin-top: 4px; line-height: 1.4; }

    .form-body { padding: 24px; display: flex; flex-direction: column; gap: 20px; }
    .section-title { font-size: 12px; font-weight: 800; color: #751445; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #fce7f1; padding-bottom: 6px; }

    .form-group { display: flex; flex-direction: column; gap: 5px; }
    .form-group label { font-size: 12px; font-weight: 700; color: #334155; }
    .form-control { border: 1.5px solid #cbd5e1; border-radius: 8px; padding: 10px 12px; font-size: 13px; outline: none; background: #fff; transition: border-color 0.2s; }
    .form-control:focus { border-color: #8e1c56; }
    textarea.form-control { resize: vertical; min-height: 70px; }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    @media (max-width: 500px) { .grid-2 { grid-template-columns: 1fr; } }

    .check-card { display: flex; align-items: center; gap: 8px; background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 8px 12px; cursor: pointer; user-select: none; font-size: 12px; }
    .check-card:hover { background: #f1f5f9; border-color: #cbd5e1; }
    .check-card input { accent-color: #8e1c56; }

    .scroll-box { max-height: 160px; overflow-y: auto; border: 1.5px solid #cbd5e1; border-radius: 8px; padding: 8px; display: flex; flex-direction: column; gap: 6px; background: #fff; }

    .btn-submit { background: #8e1c56; color: #ffffff; border: none; border-radius: 10px; padding: 14px; font-size: 14px; font-weight: 800; cursor: pointer; transition: background 0.2s; box-shadow: 0 4px 10px rgba(142, 28, 86, 0.2); }
    .btn-submit:hover { background: #751445; }
    .btn-submit:disabled { background: #94a3b8; cursor: not-allowed; }

    .alert { display: none; padding: 14px; border-radius: 10px; font-size: 13px; font-weight: bold; text-align: center; margin-top: 10px; }
    .alert-success { background: #ecfdf5; border: 1.5px solid #a7f3d0; color: #065f46; }
    .alert-error { background: #fff1f2; border: 1.5px solid #fecdd3; color: #9f1239; }
  </style>
</head>
<body>

<div class="form-card">
  <div class="form-header">
    <h1>Douaisis Agglo • Benchmark Solutions & IA</h1>
    <p>Répertoire des cas d'usage, solutions IA et initiatives d'autres collectivités territoriales.</p>
  </div>

  <div class="form-body">
    <!-- 1. Fiche Solution -->
    <div class="section-title">1. Fiche Solution & Référence</div>

    <div class="grid-2">
      <div class="form-group">
        <label>Nom de la solution / projet *</label>
        <input type="text" id="nomSolution" class="form-control" placeholder="Ex: Albert, Tchap, Assistant subventions" required />
      </div>
      <div class="form-group">
        <label>Collectivité ou organisme source</label>
        <input type="text" id="collectiviteSource" class="form-control" placeholder="Ex: Département du Nord, Ville de Lyon, DINUM" />
      </div>
    </div>

    <div class="form-group">
      <label>Direction ciblée à l'Agglo *</label>
      <select id="directionCible" class="form-control" onchange="onDirectionSelected()">
        <option value="">-- Sélectionnez une direction --</option>
        <option value="Transition Agricole et Alimentaire">Transition Agricole et Alimentaire</option>
        <option value="Archéologie préventive">Archéologie préventive</option>
        <option value="Equipements culturels et de Loisirs">Equipements culturels et de Loisirs</option>
        <option value="Affaires juridiques">Affaires juridiques</option>
        <option value="Contrôle de gestion">Contrôle de gestion</option>
        <option value="Ressources humaines">Ressources humaines</option>
        <option value="Développement économique">Développement économique</option>
        <option value="Technologies de l'information">Technologies de l'information</option>
        <option value="Tourisme">Tourisme</option>
        <option value="Communication">Communication</option>
        <option value="Protection de la donnée">Protection de la donnée</option>
        <option value="Grands projets">Grands projets</option>
        <option value="Cycle de l'eau">Cycle de l'eau</option>
        <option value="Déchets - propreté">Déchets - propreté</option>
        <option value="Aménagement, voiries, espaces naturels">Aménagement, voiries, espaces naturels</option>
        <option value="Transition écologique, mobilité, qualité">Transition écologique, mobilité, qualité</option>
        <option value="Cohésion sociale">Cohésion sociale</option>
        <option value="Habitat Parc Privé">Habitat Parc Privé</option>
        <option value="Habitat Parc Social">Habitat Parc Social</option>
      </select>
    </div>

    <!-- Missions filtrées par Direction -->
    <div class="form-group" id="blocMissions" style="display: none;">
      <label>Mission(s) concernée(s) dans cette direction</label>
      <div id="containerMissions" class="scroll-box"></div>
    </div>

    <div class="form-group">
      <label>Cas d'usage concret / Fonctionnalités</label>
      <textarea id="casUsage" class="form-control" placeholder="Description de l'usage : traitement des demandes, synthèse de délibérations, assistance usager..."></textarea>
    </div>

    <div class="form-group">
      <label>Lien vers la documentation / site web</label>
      <input type="url" id="lienDoc" class="form-control" placeholder="https://..." />
    </div>

    <!-- 2. Données & Souveraineté -->
    <div class="section-title">2. Données & Accès</div>

    <div class="form-group">
      <label>Format des données nécessaires (input)</label>
      <div class="grid-2">
        <label class="check-card"><input type="checkbox" class="format-check" value="Base de données / API"><span>Base de données / API</span></label>
        <label class="check-card"><input type="checkbox" class="format-check" value="Fichiers structurés (Excel, CSV)"><span>Fichiers structurés (Excel, CSV)</span></label>
        <label class="check-card"><input type="checkbox" class="format-check" value="Documents non structurés (PDF, mails, scans)"><span>Documents (PDF, mails, scans)</span></label>
        <label class="check-card"><input type="checkbox" class="format-check" value="Flux temps réel"><span>Flux temps réel</span></label>
      </div>
    </div>

    <div class="grid-2">
      <div class="form-group">
        <label>Sensibilité des données</label>
        <select id="sensibiliteDonnees" class="form-control">
          <option value="Données publiques / Open Data">Données publiques / Open Data</option>
          <option value="Données internes non sensibles">Données internes non sensibles</option>
          <option value="Données personnelles (RGPD)">Données personnelles (RGPD)</option>
          <option value="Données sensibles / secret pro">Données sensibles / secret pro</option>
        </select>
      </div>
      <div class="form-group">
        <label>Où fonctionne l'outil ?</label>
        <select id="hebergementSouverainete" class="form-control">
          <option value="Installé sur les serveurs de l'Agglo (Interne)">Installé sur les serveurs de l'Agglo (Interne)</option>
          <option value="Solution en ligne sécurisée France / Europe">Solution en ligne sécurisée France / Europe</option>
          <option value="Solution en ligne standard (Cloud hors UE Mondial)">Solution en ligne standard (Cloud hors UE Mondial)</option>
          <option value="Je ne sais pas">Je ne sais pas</option>
        </select>
      </div>
    </div>

    <!-- 3. Pilotage & Faisabilité -->
    <div class="section-title">3. Pilotage & Arbitrage</div>

    <div class="grid-2">
      <div class="form-group">
        <label>Délai de mise en œuvre</label>
        <select id="maturiteDeploiement" class="form-control">
          <option value="Rapide">Rapide</option>
          <option value="Moyen terme">Moyen terme</option>
          <option value="Long terme">Long terme</option>
        </select>
      </div>
      <div class="form-group">
        <label>Impact / Gain attendu</label>
        <select id="gainImpact" class="form-control">
          <option value="Fort (gain > 10h/mois ou service usager majeur)">Fort (gain majeur)</option>
          <option value="Moyen">Moyen</option>
          <option value="Faible / Confort">Faible / Confort</option>
        </select>
      </div>
    </div>

    <div class="grid-2">
      <div class="form-group">
        <label>Supervision requise</label>
        <select id="supervisionAiAct" class="form-control">
          <option value="Risque minimal / Libre">Risque minimal / Libre</option>
          <option value="Risque modéré (transparence)">Risque modéré (transparence)</option>
          <option value="Haut risque (contrôle humain strict)">Haut risque (contrôle strict)</option>
        </select>
      </div>
      <div class="form-group">
        <label>Modèle économique</label>
        <select id="modeleEco" class="form-control">
          <option value="Open-source / Gratuit">Open-source / Gratuit</option>
          <option value="Abonnement SaaS">Abonnement SaaS</option>
          <option value="Marché public / Licence perpétuelle">Marché public / Licence</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label>Avis d'opportunité & Commentaires</label>
      <textarea id="avisCommentaires" class="form-control" placeholder="Retours d'expérience constatés, alertes ou points d'attention..."></textarea>
    </div>

    <button id="btnSubmit" class="btn-submit" onclick="submitBenchmark()">Enregistrer dans le Benchmark</button>
    <div id="alertSuccess" class="alert alert-success">✓ Fiche benchmark enregistrée avec succès dans Grist !</div>
    <div id="alertError" class="alert alert-error"></div>
  </div>
</div>

<script>
  const GRIST_HOST = "https://grist.incubateur.anct.gouv.fr";
  const DOC_ID = "aasuJBar36th";
  const TABLE_NAME = "Benchmark";

  window.addEventListener('DOMContentLoaded', () => {
    syncChoicesFromGrist();
  });

  async function syncChoicesFromGrist() {
    try {
      const res = await fetch(`${GRIST_HOST}/api/docs/${DOC_ID}/tables/${TABLE_NAME}/columns`);
      if (res.ok) {
        const data = await res.json();
        const colHeb = (data.columns || []).find(c => c.id === 'Hebergement_Souverainete');
        if (colHeb && colHeb.fields && colHeb.fields.widgetOptions) {
          const opts = JSON.parse(colHeb.fields.widgetOptions);
          if (opts.choices && opts.choices.length > 0) {
            const selectEl = document.getElementById('hebergementSouverainete');
            selectEl.innerHTML = opts.choices.map(c => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
          }
        }
      }
    } catch (e) {}
  }

  async function onDirectionSelected() {
    const dir = document.getElementById('directionCible').value;
    const bloc = document.getElementById('blocMissions');
    const container = document.getElementById('containerMissions');

    if (!dir) {
      bloc.style.display = 'none';
      return;
    }

    bloc.style.display = 'flex';
    container.innerHTML = '<span style="font-size:11px; color:#94a3b8;">Chargement des missions en cours...</span>';

    try {
      const res = await fetch(`${GRIST_HOST}/api/docs/${DOC_ID}/tables/Missions/records`);
      if (res.ok) {
        const data = await res.json();
        const missions = (data.records || []).filter(r => r.fields.Direction === dir);

        if (missions.length > 0) {
          container.innerHTML = missions.map(r => `
            <label class="check-card">
              <input type="checkbox" class="mission-check" value="${r.id}">
              <span>${escapeHtml(r.fields.Nom_Mission || `Mission #${r.id}`)}</span>
            </label>
          `).join('');
          return;
        }
      }
      container.innerHTML = '<span style="font-size:12px; color:#64748b; line-height:1.4;">Aucune mission enregistrée pour cette direction.<br><strong style="color:#751445;">Passez d\'abord par le formulaire de diagnostic pour déclarer la mission.</strong></span>';
    } catch (e) {
      container.innerHTML = '<span style="font-size:11px; color:#ef4444;">Erreur lors du chargement des missions.</span>';
    }
  }

  async function submitBenchmark() {
    const nom = document.getElementById('nomSolution').value.trim();
    const direction = document.getElementById('directionCible').value;

    if (!nom) {
      alert("Veuillez renseigner le nom de la solution.");
      return;
    }
    if (!direction) {
      alert("Veuillez sélectionner une direction.");
      return;
    }

    const btn = document.getElementById('btnSubmit');
    const alertSuccess = document.getElementById('alertSuccess');
    const alertError = document.getElementById('alertError');
    alertSuccess.style.display = 'none';
    alertError.style.display = 'none';
    btn.disabled = true;
    btn.textContent = "Enregistrement en cours...";

    try {
      const selectedMissions = ['L'];
      document.querySelectorAll('.mission-check:checked').forEach(c => {
        selectedMissions.push(parseInt(c.value, 10));
      });

      const formats = ['L'];
      document.querySelectorAll('.format-check:checked').forEach(c => formats.push(c.value));

      const payload = {
        records: [{
          fields: {
            Nom_Solution: nom,
            Collectivite_Source: document.getElementById('collectiviteSource').value.trim(),
            Direction_Cible: direction,
            Missions_Cibles: selectedMissions,
            Cas_Usage: document.getElementById('casUsage').value.trim(),
            Lien_Doc: document.getElementById('lienDoc').value.trim(),
            Format_Donnees: formats,
            Sensibilite_Donnees: document.getElementById('sensibiliteDonnees').value,
            Hebergement_Souverainete: document.getElementById('hebergementSouverainete').value,
            Maturite_Deploiement: document.getElementById('maturiteDeploiement').value,
            Gain_Impact_Estime: document.getElementById('gainImpact').value,
            Supervision_AI_Act: document.getElementById('supervisionAiAct').value,
            Modele_Economique: document.getElementById('modeleEco').value,
            Avis_Commentaires: document.getElementById('avisCommentaires').value.trim()
          }
        }]
      };

      const resBench = await fetch(`${GRIST_HOST}/api/docs/${DOC_ID}/tables/${TABLE_NAME}/records`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      if (!resBench.ok) {
        const errJson = await resBench.json();
        throw new Error(errJson.error || `Erreur ${resBench.status}`);
      }

      alertSuccess.style.display = 'block';

      document.getElementById('nomSolution').value = '';
      document.getElementById('collectiviteSource').value = '';
      document.getElementById('casUsage').value = '';
      document.getElementById('lienDoc').value = '';
      document.getElementById('avisCommentaires').value = '';
      document.querySelectorAll('.format-check, .mission-check').forEach(cb => cb.checked = false);

      setTimeout(() => { alertSuccess.style.display = 'none'; }, 4000);
    } catch (err) {
      alertError.textContent = "Échec de l'envoi : " + err.message;
      alertError.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = "Enregistrer dans le Benchmark";
    }
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
</script>

</body>
</html>
